doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1= title
    .chat-container
      #messages
      .message-box
        input#chat-input(type="text", placeholder="Type a message...")
        button#send-btn Send
    .emoji-container
      button.emoji-btn(id="smiley") 😊
      button.emoji-btn(id="fire") 🔥
      button.emoji-btn(id="gun") 🔫
    script(src="/socket.io/socket.io.js")
    script(src="/js/chat.js")